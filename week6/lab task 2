
#include <iostream>
using namespace std;

struct Node
{
    int data;
    Node* prev;
    Node* next;
};

class Deque
{
private:
    Node* front;
    Node* rear;

public:
    Deque()
    {
        front = NULL;
        rear = NULL;
    }

    // Insert at the front
    void insertFront(int value)
    {
        Node* newNode = new Node;
        newNode->data = value;
        newNode->prev = NULL;
        newNode->next = front;

        if (front == NULL)
        {
            front = newNode;
            rear = newNode;
        }
        else
        {
            front->prev = newNode;
            front = newNode;
        }

        cout << value << " inserted at front.\n";
    }

    // Insert at the rear
    void insertRear(int value)
    {
        Node* newNode = new Node;
        newNode->data = value;
        newNode->next = NULL;
        newNode->prev = rear;

        if (rear == NULL)
        {
            front = newNode;
            rear = newNode;
        }
        else
        {
            rear->next = newNode;
            rear = newNode;
        }

        cout << value << " inserted at rear.\n";
    }

    // Delete from the front
    void deleteFront()
    {
        if (front == NULL)
        {
            cout << "Deque is empty.\n";
            return;
        }

        Node* ptr = front;
        cout << "Deleted from front: " << ptr->data << endl;

        front = front->next;

        if (front == NULL)
        {
            rear = NULL;
        }
        else
        {
            front->prev = NULL;
        }

        delete ptr;
    }

    // Delete from the rear
    void deleteRear()
    {
        if (rear == NULL)
        {
            cout << "Deque is empty.\n";
            return;
        }

        Node* ptr = rear;
        cout << "Deleted from rear: " << ptr->data << endl;

        rear = rear->prev;

        if (rear == NULL)
        {
            front = NULL;
        }
        else
        {
            rear->next = NULL;
        }

        delete ptr;
    }

    // Display from front to rear
    void display()
    {
        if (front == NULL)
        {
            cout << "Deque is empty.\n";
            return;
        }

        Node* ptr = front;

        cout << "Deque: ";
        while (ptr != NULL)
        {
            cout << ptr->data << " ";
            ptr = ptr->next;
        }

        cout << endl;
    }
};

int main()
{
    Deque d;
    int choice, value;

    do
    {
        cout << "\n1. Insert at Front";
        cout << "\n2. Insert at Rear";
        cout << "\n3. Delete from Front";
        cout << "\n4. Delete from Rear";
        cout << "\n5. Display";
        cout << "\n6. Exit";
        cout << "\nEnter choice: ";
        cin >> choice;

        switch (choice)
        {
            case 1:
                cout << "Enter value: ";
                cin >> value;
                d.insertFront(value);
                break;

            case 2:
                cout << "Enter value: ";
                cin >> value;
                d.insertRear(value);
                break;

            case 3:
                d.deleteFront();
                break;

            case 4:
                d.deleteRear();
                break;

            case 5:
                d.display();
                break;

            case 6:
                cout << "Program ended.\n";
                break;

            default:
                cout << "Invalid choice.\n";
        }
    }
    while (choice != 6);

    return 0;
}
